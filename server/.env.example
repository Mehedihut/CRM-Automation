# Server environment
NODE_ENV=development
PORT=4000

# CORS origin(s) for the client (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection (DO NOT commit real values)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=

# If you ever want to use a separate shadow DB for Prisma migrations (optional)
# SHADOW_DATABASE_URL=

# --- Auth ---
# REQUIRED in production. The dev fallback ("dev-insecure-jwt-secret-change-me")
# is intentionally weak so that misconfigured prod boots fail loudly on first
# JWT sign.
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_EXPIRES_IN=7d
# Leave blank for localhost. Set to ".yourdomain.com" in production.
COOKIE_DOMAIN=
BCRYPT_ROUNDS=10

# --- Integration credentials (optional, stubbed) ---
# Meta/Facebook Lead Ads (webhook + outbound)
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# WhatsApp Business API
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=
# Puku
# PUKU_API_BASE_URL=
# PUKU_API_TOKEN=
