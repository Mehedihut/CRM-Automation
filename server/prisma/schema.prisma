// CRM-Automation — Prisma schema
// PostgreSQL is the production database.
// NOTE: This schema is intentionally minimal for the foundation step.
// It will be extended later with: User, Role, Team, Lead, LeadAssignment,
// LeadCall, LeadStatus, WhatsAppMessage, FollowUp, PukuAccessRequest, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
