// CRM-Automation — SQLite dev schema (LOCAL-ONLY)
// This mirrors the production Postgres schema for environments without Docker/Postgres.
// Enums are replaced by String + TS-side constants. Do NOT use this in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("AGENT") // "ADMIN" | "AGENT"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads      Lead[]              @relation("AssignedAgent")
  callsLogged        Call[]
  whatsappsLogged    WhatsappMessage[]
  followUpsAssigned  FollowUp[]
  pukuRequestsMade   PukuAccessRequest[] @relation("RequestedBy")
  pukuDecisions      PukuAccessRequest[] @relation("DecidedBy")
}

model Lead {
  id           String     @id @default(cuid())
  fullName     String
  email        String?
  phone        String
  company      String?
  source       String?
  status       String     @default("NEW")
  notes        String?
  assignedToId String?
  assignedTo   User?      @relation("AssignedAgent", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  calls            Call[]               @relation("LeadCalls")
  whatsapps        WhatsappMessage[]    @relation("LeadWhatsapps")
  followUps        FollowUp[]           @relation("LeadFollowUps")
  pukuRequests     PukuAccessRequest[]  @relation("LeadPukuRequests")
  courseInterests  LeadCourseInterest[] @relation("LeadCourseInterests")

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model Course {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interests LeadCourseInterest[] @relation("CourseInterests")

  @@index([isActive])
}

model LeadCourseInterest {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation("LeadCourseInterests", fields: [leadId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation("CourseInterests", fields: [courseId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, courseId])
  @@index([leadId])
  @@index([courseId])
}

model Call {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation("LeadCalls", fields: [leadId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User        @relation(fields: [agentId], references: [id])
  outcome     String
  durationSec Int?
  notes       String?
  calledAt    DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([leadId])
  @@index([agentId])
  @@index([calledAt])
}

model WhatsappMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation("LeadWhatsapps", fields: [leadId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id])
  direction String   // "OUTBOUND" | "INBOUND"
  body      String
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([sentAt])
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User     @relation(fields: [agentId], references: [id])
  scheduledFor DateTime
  status       String   @default("PENDING")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([agentId])
}

model PukuAccessRequest {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation("LeadPukuRequests", fields: [leadId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy  User     @relation("RequestedBy", fields: [requestedById], references: [id])
  status       String   @default("PENDING")
  reason       String?
  decidedById  String?
  decidedBy    User?    @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}
